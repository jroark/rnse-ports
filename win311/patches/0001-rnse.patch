+/* Where in the frame buffer the picture was drawn last: for a program
+   that shows it some other way (scaled down, or a part of it).  w 0: no
+   picture (blank, or nothing drawn yet). */
+void vga_picture_rect(VGAState *s, int *x, int *y, int *w, int *h)
+{
+    FBDevice *fb_dev = s->fb_dev;
+    *x = *y = *w = *h = 0;
+    if (s->graphic_mode == 2 && s->last_gw > 0) {
+        *w = s->last_gw;
+        *h = s->last_gh;
+        *x = *w < fb_dev->width ? (fb_dev->width - *w) / 2 : 0;
+        *y = *h < fb_dev->height ? (fb_dev->height - *h) / 2 : 0;
+    } else if (s->graphic_mode == 1 && s->last_text_w1 > 0) {
+        *x = s->last_text_x1;
+        *y = s->last_text_y1;
+        *w = s->last_text_w1;
+        *h = s->last_text_h1;
