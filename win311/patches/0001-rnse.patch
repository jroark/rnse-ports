+/* The 16-colour planar modes as Windows' VGA driver uses them (mode 12h):
+   for a program that draws them itself from video memory (the RNS-E's
+   port, win311/port/screen.c), a word of four planes for every eight
+   pixels.  1 with the picture's particulars when it is one of them
+   plainly: four planes, the full dot clock, every line once, no panning,
+   no split screen, no CGA addressing; 0 for anything else. */
+int vga_planar_get(VGAState *s, struct vga_planar *p)
+{
+    /* (as vga_refresh decides it, which the caller need not have run) */
+    if (!(s->ar_index & 0x20) || !(s->gr[0x06] & 1) || vbe_enabled(s))
+        return 0;
+    if (((s->gr[0x05] >> 5) & 3) != 0 || (s->sr[0x01] & 8) ||
+        (s->cr[0x09] & 0x9f) || (s->ar[0x12] & 0xf) != 0xf ||
+        (s->ar[0x13] & 7) || (s->cr[0x17] & 3) != 3)
+        return 0;
+    int w = (s->cr[0x01] + 1) * 8;
+    int h = (s->cr[0x12] | ((s->cr[0x07] & 0x02) << 7) |
+             ((s->cr[0x07] & 0x40) << 3)) + 1;
+    int line_compare = s->cr[0x18] | ((s->cr[0x07] & 0x10) << 4) |
+        ((s->cr[0x09] & 0x40) << 3);
+    if (line_compare < h)
+        return 0;
+    p->vram = s->vga_ram;
+    p->vram_size = s->vga_ram_size;
+    p->start = 4 * (s->cr[0x0d] | (s->cr[0x0c] << 8));
+    p->line_offset = s->cr[0x13] << 3;
+    p->w = w;
+    p->h = h;
+    for (int i = 0; i < 16; i++) {
+        uint32_t v = s->ar[i];
+        if (s->ar[0x10] & 0x80)
+            v = ((s->ar[0x14] & 0xf) << 4) | (v & 0xf);
+        else
+            v = ((s->ar[0x14] & 0xc) << 4) | (v & 0x3f);
+        v = (v & s->dac_mask) * 3;
+        p->palette[i] = (c6_to_8(s->palette[v]) << 16) |
+            (c6_to_8(s->palette[v + 1]) << 8) | c6_to_8(s->palette[v + 2]);
+    }
+    return 1;
+}
