Doom on the RNS-E 192 (doom/build.sh): doomgeneric without floating point,
since the game is built for -m4-nofpu and has no soft-float library, and
without SDL (-DRNSE).

diff -ru a/g_game.c b/g_game.c
--- a/g_game.c	2026-10-11 06:12:25
+++ b/g_game.c	2026-11-15 18:22:38
@@ -2251,19 +2251,20 @@
 	 
     if (timingdemo) 
     { 
-        float fps;
+        int fps10;
         int realtics;
 
 	endtime = I_GetTime (); 
         realtics = endtime - starttime;
-        fps = ((float) gametic * TICRATE) / realtics;
+        // (RNS-E: no floating point; tenths of a frame a second.)
+        fps10 = realtics > 0 ? gametic * TICRATE * 10 / realtics : 0;
 
         // Prevent recursive calls
         timingdemo = false;
         demoplayback = false;
 
-	I_Error ("timed %i gametics in %i realtics (%f fps)",
-                 gametic, realtics, fps);
+	I_Error ("timed %i gametics in %i realtics (%i.%i fps)",
+                 gametic, realtics, fps10 / 10, fps10 % 10);
     } 
 	 
     if (demoplayback) 
